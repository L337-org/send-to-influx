#!/bin/sh
# preinst for send-to-influx.deb
set -e

# Only "upgrade" (and "install" over a still-configured leftover) matter here;
# a genuinely fresh install has nothing to clean up.
case "$1" in
    upgrade|install) ;;
    *) exit 0 ;;
esac

# dpkg-reconfigure ALSO runs preinst, as "upgrade <version>" - indistinguishable
# from a real upgrade by its arguments alone - but with NO unpack following it, so
# anything removed here on that path is gone permanently and breaks the install.
# dpkg-reconfigure exports DEBCONF_RECONFIGURE=1 (the same flag postinst uses to
# tell the two apart), which is the only reliable discriminator; verified to be
# visible here. Bail out before touching anything.
if [ "${DEBCONF_RECONFIGURE:-}" = "1" ]; then
    exit 0
fi

# Stop a running service before its code is removed below, and leave a marker
# so postinst starts it again on the new version.
#
# Removing the venv under a live process does not stop it, it breaks it: anything
# it loads from the venv between the removal and the unpack is missing - a lazy
# import, a new worker process, or a data file such as certifi's CA bundle, which
# every HTTPS write reads. Were the service to exit in that window, postinst would
# see only the aftermath (failed, or "activating" while waiting out RestartSec),
# not that it had been running, and leave it down with no restart message.
#
# "activating" counts as running: it is a service waiting to be restarted, which
# the operator expects to come back. Only the old prerm runs before this script
# on an upgrade, and it stops nothing then, so the stop has to be here to take
# effect on the upgrade that ships it.
#
# The marker is in /run, so a reboot clears it. One left behind by an upgrade
# that failed after this point is what the next successful configure should
# act on: the service was running before that upgrade began.
UPGRADE_MARKER=/run/send-to-influx.restart-after-upgrade
if [ -d /run/systemd/system ]; then
    state=$(systemctl is-active send-to-influx 2>/dev/null || true)
    case "$state" in
        active|activating|reloading)
            : > "$UPGRADE_MARKER"
            if ! systemctl stop send-to-influx; then
                echo "send-to-influx: stopping the service before the upgrade failed (state was '$state'); continuing - it will be restarted once the upgrade completes." >&2
            fi
            ;;
    esac
fi

# Remove the bundled virtualenv, so the unpack that follows lays down a pristine
# one.
#
# The venv is entirely package-owned and recreated by every install: no
# configuration (that is /etc/send-to-influx), no credentials (the credstore), and
# nothing user-editable lives in it. Replacing it wholesale rather than letting dpkg
# merge over it removes a whole class of failure at once:
#
#  - Stale modules from a previous version being imported in preference to the new
#    ones. This bit in the field: a 4.4 install logged its 4.4 version banner while
#    running pre-4.3 library code, so it failed with "unexpected keyword argument
#    'use_buffer'" and "Source nuki not found" - the entry point was new, the
#    package behind it was old.
#  - lib/python<major.minor>/ directories left over from a package built against a
#    different interpreter, which dpkg cannot always replace with the symlinks the
#    current layout uses (it will not swap a non-empty directory for a symlink), and
#    which then shadow the real site-packages directory.
#  - Runtime-generated __pycache__ files, which dpkg does not own and will not clean
#    up, keeping those directories alive.
#
# Bytecode and orphaned modules are always safe to delete: everything is
# regenerated by the unpack, and postinst starts the service again afterwards
# if it was running (stopped above).
#
# Accepted tradeoff: if the unpack that follows fails (disk full, corrupt
# archive, interrupted upgrade), there is no venv left and the service cannot
# start - dpkg has no copy of the old one to restore. Recovery is to install the
# package again, which rebuilds it. Judged better than the alternative, where a
# half-replaced venv can run silently with a mix of old and new modules.
rm -rf /opt/send-to-influx/venv

exit 0
