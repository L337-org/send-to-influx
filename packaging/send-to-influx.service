[Unit]
Description=send-to-influx - collect smart home/energy metrics and write to InfluxDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=send-to-influx
Group=send-to-influx
WorkingDirectory=/opt/send-to-influx
ExecStart=/opt/send-to-influx/venv/bin/send-to-influx --settings /etc/send-to-influx/settings.yaml
Restart=on-failure
RestartSec=5
# Exit code 1 covers every condition that needs manual intervention and never
# resolves itself by waiting - a fatal ConfigError, or "nothing to collect"
# (no sources configured, or a configured source with no usable target). None
# of those benefit from a restart loop, so this stops systemd respawning the
# service every RestartSec - deliberately not paired with SuccessExitStatus=1,
# so the unit still reports Active: failed (Result: exit-code) rather than a
# clean inactive/dead: an admin (or a monitoring tool alerting on
# systemctl is-failed) should still be told the service stopped and needs
# attention, just without the pointless crash-loop. See AGENTS.md/README.md's
# exit-code table.
RestartPreventExitStatus=1

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# No ReadWritePaths for /etc/send-to-influx, deliberately. The daemon writes nothing there:
# settings.yaml is written by postinst and by send-to-influx-set-credential, both run by an
# admin outside this unit; the settings permission check only reports what to fix rather than
# chmod-ing anything; and the OAuth state file lives in StateDirectory below. ProtectSystem
# =strict therefore leaves the whole of /etc read-only to this service, which is what should
# always have been the case - the directive existed only because the state file used to
# default into /etc, where the service user could not write it anyway.

# The MCP server's OAuth state (client registrations and hashed refresh tokens) lives
# here, not in /etc: it is runtime state rather than configuration, and /etc is
# root-owned. systemd creates /var/lib/send-to-influx owned by the service user and adds
# it to ReadWritePaths implicitly, which is what makes the state actually persist -
# previously the write failed with PermissionError on every save, so a connected MCP
# client had to re-authorize after every restart. 0700 because the file holds tokens.
StateDirectory=send-to-influx
StateDirectoryMode=0700

# Sandbox hardening. Especially relevant since the MCP server made this the
# project's first inbound-network-facing service (it binds a loopback TCP port).
# This set is deliberately the well-established, low-risk directives that don't
# break a pure-Python service that makes outbound HTTPS (requests), runs an
# async HTTP server (uvicorn/anyio), and reads systemd-creds. The service needs
# no privileges (it binds 8420 > 1024, so not even CAP_NET_BIND_SERVICE), so the
# capability set is emptied.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
# AF_UNIX is kept alongside the INET families: glibc NSS/resolver and syslog use
# Unix sockets, so dropping it can break name resolution and logging.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# @system-service is systemd's curated allow-list for normal services and covers
# threads, sockets and file I/O (uvicorn/anyio/requests). MemoryDenyWriteExecute
# is deliberately NOT set - it breaks some Python C extensions - and neither is a
# hand-rolled narrower SystemCallFilter, which is fragile across interpreter and
# library versions.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
